# ============================================================
# 首爾旅遊地圖平台 (Seoul Tour Map) - 環境變數配置
# ============================================================
# 複製此檔案為 .env 並根據需要修改值
# .env 已加入 .gitignore，不會被提交到版本控制
# ============================================================

# --------------------- 通用設定 ---------------------
PORT=8092

# --------------------- Ollama Cloud API ---------------------
OLLAMA_API_BASE=https://ollama.com/v1
OLLAMA_API_KEY=c309d7242319461783142d44f3949473.Cvsj6THEdCx3lfLBGAwYgtWx
#OLLAMA_MODEL=gemma4:31b-cloud
OLLAMA_MODEL=qwen3.5:397b-cloud

# --------------------- Hermes Worker ---------------------
# 設為 true 啟用 Hermes Worker（需同時啟動 hermes_worker.py）
# 設為 false 則所有查詢直接走 Ollama Cloud API
HERMES_ENABLED=true
HERMES_TASK_DIR=/tmp/hermes_tasks
HERMES_TIMEOUT=120

# --------------------- Hermes Agent API ---------------------
# Hermes Agent 是進階後端，Hermes Worker 可自動 fallback
HERMES_AGENT_API_URL=https://api-hermes.apihubs.dev/v1
HERMES_AGENT_API_KEY=your_hermes_agent_api_key_here


# Korea Public Data Portal Key
DATA_GO_KR_KEY=YOUR_SERVICE_KEY_HERE

# VisitKorea (TourAPI 4.0) Key
VISIT_KOREA_API_KEY=YOUR_VISIT_KOREA_KEY_HERE

# Seoul Open Data Plaza Key
SEOUL_DATA_API_KEY=YOUR_SEOUL_DATA_KEY_HERE

# ODsay LAB Key (Foreigner friendly)
ODSAY_API_KEY=YOUR_ODSAY_KEY_HERE

# Google Places API Key
GOOGLE_PLACES_API_KEY=AIzaSyAkF8tqNpBtqMEVs-6-k4on5jBreptgh5g

# --------------------- Radius Filter Defaults ---------------------
RADIUS_DEFAULT_VAL=5
RADIUS_DEFAULT_UNIT=km
RADIUS_DEFAULT_CENTER_LAT=37.5665
RADIUS_DEFAULT_CENTER_LNG=126.9780
